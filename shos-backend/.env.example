# ==============================================================================
# SHOS Backend Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

PORT=5000
NODE_ENV=development

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Supabase PostgreSQL & Realtime Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_service_role_key

# SMTP Email Configuration (Nodemailer - e.g., Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_hospital_support@gmail.com
SMTP_PASS=your_16_digit_app_password_here
SMTP_FROM=your_hospital_support@gmail.com
